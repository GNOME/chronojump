msgid "Horizontal:"
msgstr "Horitzontal:"

#: ../src/gui/modes/forceSensorExercise.cs:474
msgid "Movements where a significant mass is accelerated."
msgstr "Moviments en els quals s'accelera una massa significativa."

#: ../src/gui/modes/forceSensorExercise.cs:475
